# --- Database ---
DATABASE_URL=postgresql://erapor:erapor@localhost:5432/erapor

# --- Backend API ---
# Wajib: minimal 32 karakter acak
SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
PORT=3001
NODE_ENV=development

# Sesi login (jam). Default: 12
SESSION_TTL_HOURS=12
# Nama cookie sesi. Default: school_report_session
SESSION_COOKIE_NAME=school_report_session
# Kirim cookie hanya via HTTPS. Default: true saat NODE_ENV=production, false saat development
# COOKIE_SECURE=false

# Biaya hash bcrypt (4-31). Default: 12
BCRYPT_ROUNDS=12

# Rate limit login: jumlah percobaan per jendela waktu per IP+email
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Path binary Chromium untuk render PDF rapor.
# Default: /opt/meta-chromium/chrome
# CHROME_EXECUTABLE_PATH=/opt/meta-chromium/chrome
PDF_TIMEOUT_MS=30000

# Masa berlaku token preview import (menit). Default: 30
IMPORT_PREVIEW_TTL_MINUTES=30
# Ukuran maksimal file upload import (MB). Default: 10
MAX_UPLOAD_MB=10

# Seed (hanya dipakai packages/database/prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@sekolah.id
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrator

# --- Frontend ---
# URL backend API — dipakai server-side oleh proxy /api/v1 di Next.js.
# Default: http://localhost:3001
API_URL=http://localhost:3001
# Nama cookie sesi — harus sama dengan SESSION_COOKIE_NAME backend.
# Default: school_report_session
# SESSION_COOKIE_NAME=school_report_session
# Port aplikasi web. Default: 3000
# PORT=3000
